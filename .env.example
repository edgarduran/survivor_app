# Copy this file to .env and fill in values for local development.
# Never commit .env — it is gitignored.

# Google OAuth (https://console.cloud.google.com)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Facebook OAuth (https://developers.facebook.com)
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=

# Twitter/X OAuth (https://developer.twitter.com)
TWITTER_API_KEY=
TWITTER_API_SECRET=
