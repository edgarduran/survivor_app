<div class="max-w-4xl mx-auto">
  <div class="flex justify-between items-center mb-8">
    <h2 class="text-3xl font-bold text-gray-800">
      Welcome, <%= current_user.first_name.presence || current_user.email %>!
    </h2>
    <%= link_to "Create Pool", new_pool_path, class: "bg-blue-900 text-white px-4 py-2 rounded font-semibold hover:bg-blue-800" %>
  </div>

  <% if @pools.empty? %>
    <div class="bg-white rounded-lg shadow p-10 text-center">
      <p class="text-gray-500 text-lg">You're not in any pools yet.</p>
      <%= link_to "Create your first pool", new_pool_path, class: "mt-3 inline-block text-blue-900 font-semibold hover:underline" %>
    </div>
  <% else %>
    <div class="grid gap-4 md:grid-cols-2">
      <% @pools.each do |pool| %>
        <%= link_to pool_path(pool), class: "bg-white rounded-lg shadow p-6 hover:shadow-md transition-shadow block" do %>
          <div class="flex justify-between items-start mb-2">
            <h3 class="text-xl font-semibold text-gray-800"><%= pool.name %></h3>
            <% membership = pool.pool_memberships.find { |m| m.user_id == current_user.id } %>
            <% if membership&.admin? %>
              <span class="bg-blue-100 text-blue-800 text-xs font-semibold px-2 py-1 rounded">Commissioner</span>
            <% else %>
              <span class="bg-gray-100 text-gray-600 text-xs font-semibold px-2 py-1 rounded">Member</span>
            <% end %>
          </div>
          <p class="text-gray-500 text-sm"><%= pool.season.label %></p>
          <p class="text-gray-400 text-sm mt-3"><%= pool.pool_memberships.size %> <%= "member".pluralize(pool.pool_memberships.size) %></p>
        <% end %>
      <% end %>
    </div>
  <% end %>
</div>
