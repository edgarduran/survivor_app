<!-- app/views/layouts/application.html.erb -->
<!DOCTYPE html>
<html>
  <head>
    <title>Survivor Pool</title>
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <%= stylesheet_link_tag "tailwind", "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body class="bg-gray-50 min-h-screen">
    <header class="bg-blue-900 text-white py-4 shadow-md">
      <div class="container mx-auto px-4 flex justify-between items-center">
        <h1 class="text-2xl font-bold">🏈 Survivor Pool</h1>
        <nav class="flex items-center gap-4">
          <% if user_signed_in? %>
            <%= link_to "My Pools", root_path, class: "hover:underline" %>
            <%= link_to "My Picks", "#", class: "hover:underline" %>
            <%= button_to "Sign Out", destroy_user_session_path, method: :delete,
                class: "bg-white text-blue-900 font-semibold px-3 py-1 rounded hover:bg-gray-100" %>
          <% else %>
            <%= link_to "Sign In", new_user_session_path, class: "hover:underline" %>
          <% end %>
        </nav>
      </div>
    </header>

    <%= render "shared/flash" %>

    <main class="container mx-auto px-4 py-8">
      <%= yield %>
    </main>
  </body>
</html>
