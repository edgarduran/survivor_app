<div class="max-w-2xl mx-auto">
  <div class="flex justify-between items-start mb-6">
    <div>
      <h2 class="text-3xl font-bold text-gray-800"><%= @pool.name %></h2>
      <p class="text-gray-500 mt-1"><%= @pool.season.label %></p>
    </div>
    <% if current_user.admin_of?(@pool) %>
      <span class="bg-blue-100 text-blue-800 text-sm font-semibold px-3 py-1 rounded">Commissioner</span>
    <% end %>
  </div>

  <div class="bg-white rounded-lg shadow">
    <div class="px-6 py-4 border-b border-gray-100">
      <h3 class="font-semibold text-gray-700">Members (<%= @pool.pool_memberships.size %>)</h3>
    </div>
    <ul>
      <% @pool.pool_memberships.each do |membership| %>
        <li class="flex justify-between items-center px-6 py-3 border-b border-gray-50 last:border-0">
          <span class="text-gray-800">
            <%= membership.user.first_name %> <%= membership.user.last_name %>
          </span>
          <% if membership.admin? %>
            <span class="bg-blue-100 text-blue-800 text-xs font-semibold px-2 py-1 rounded">Commissioner</span>
          <% else %>
            <span class="bg-gray-100 text-gray-600 text-xs font-semibold px-2 py-1 rounded">Member</span>
          <% end %>
        </li>
      <% end %>
    </ul>
  </div>

  <%= link_to "← Back to Dashboard", root_path, class: "mt-6 inline-block text-blue-900 hover:underline text-sm" %>
</div>
