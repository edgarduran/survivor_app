<%# ── Pool header ─────────────────────────────────────────────── %>
<div class="max-w-4xl mx-auto px-0 sm:px-4">
  <div class="flex flex-wrap justify-between items-start gap-2 mb-4">
    <div>
      <h2 class="text-2xl font-bold text-gray-800"><%= @pool.name %></h2>
      <p class="text-gray-500 text-sm"><%= @pool.season.label %></p>
    </div>

    <div class="flex items-center gap-2">
      <% if @is_eliminated %>
        <span class="bg-red-100 text-red-700 text-sm font-semibold px-3 py-1 rounded-full">Eliminated</span>
      <% else %>
        <span class="bg-green-100 text-green-700 text-sm font-semibold px-3 py-1 rounded-full">Alive</span>
      <% end %>

      <div class="flex gap-1">
        <% Pick::INCORRECT_PICK_LIMIT.times do |i| %>
          <span class="text-xl"><%= i < @incorrect_count ? "⚡" : "○" %></span>
        <% end %>
      </div>

      <% if current_user.can_manage_pool?(@pool) %>
        <span class="bg-blue-100 text-blue-800 text-xs font-semibold px-2 py-1 rounded">Commissioner</span>
        <%= link_to "Manage Pool", manage_pool_path(@pool),
            class: "bg-blue-900 text-white text-xs px-3 py-1 rounded font-semibold hover:bg-blue-800" %>
      <% end %>
    </div>
  </div>

  <%# ── This week's pick ──────────────────────────────────────── %>
  <div class="bg-white rounded-lg shadow mb-4">
    <% if @current_week.nil? %>
      <div class="px-4 py-8 text-center text-gray-400">
        <p class="font-medium">No active week</p>
        <p class="text-sm mt-1">Check back when the season begins.</p>
      </div>

    <% elsif @is_eliminated %>
      <div class="px-4 py-8 text-center text-gray-400">
        <p class="font-medium">You've been eliminated from this pool.</p>
        <p class="text-sm mt-1">Better luck next season.</p>
      </div>

    <% else %>
      <div class="px-4 py-3 border-b border-gray-100 flex flex-wrap justify-between items-center gap-2">
        <h3 class="font-semibold text-gray-700">Week <%= @current_week.week_number %> Pick</h3>
        <% if @picks_locked %>
          <span class="text-xs font-semibold text-red-600 bg-red-50 px-2 py-1 rounded">LOCKED</span>
        <% else %>
          <span class="text-xs text-gray-400">
            Locks <%= @current_week.picks_lock_at.strftime("%a %b %-d at %-I:%M%p") %>
          </span>
        <% end %>
      </div>

      <div class="px-4 py-4">
        <% if @picks_locked %>
          <%# Read-only grid when locked %>
          <div class="grid grid-cols-3 sm:grid-cols-4 md:grid-cols-6 lg:grid-cols-8 gap-2">
            <% @teams.each do |team| %>
              <% is_current = @current_pick&.team_id == team.id %>
              <% is_used    = @used_team_ids.include?(team.id) %>
              <div class="border-2 rounded-lg p-2 text-center text-xs leading-tight select-none
                          <%= is_current ? 'border-blue-600 bg-blue-50 text-blue-900 font-semibold' :
                              is_used    ? 'border-gray-100 bg-gray-50 text-gray-300' :
                                           'border-gray-200 text-gray-500' %>">
                <%= team.name %>
              </div>
            <% end %>
          </div>
          <% if @current_pick.nil? %>
            <p class="text-sm text-red-500 mt-3 text-center">You did not make a pick before the deadline.</p>
          <% end %>

        <% else %>
          <%# Interactive pick form %>
          <% form_url    = @current_pick ? pool_pick_path(@pool, @current_pick) : pool_picks_path(@pool) %>
          <% form_method = @current_pick ? :patch : :post %>

          <%= form_with url: form_url, method: form_method do |f| %>
            <div class="grid grid-cols-3 sm:grid-cols-4 md:grid-cols-6 lg:grid-cols-8 gap-2 mb-4">
              <% @teams.each do |team| %>
                <% is_current = @current_pick&.team_id == team.id %>
                <% is_used    = @used_team_ids.include?(team.id) %>

                <% if is_used %>
                  <div class="border-2 border-gray-100 rounded-lg p-2 text-center text-xs
                              leading-tight text-gray-300 bg-gray-50 select-none cursor-not-allowed"
                       title="Already used this season">
                    <%= team.name %>
                  </div>
                <% else %>
                  <label class="cursor-pointer block">
                    <%= radio_button_tag "pick[team_id]", team.id, is_current, class: "peer sr-only" %>
                    <div class="border-2 rounded-lg p-2 text-center text-xs leading-tight
                                border-gray-200 text-gray-700
                                hover:border-blue-400 hover:text-blue-700
                                peer-checked:border-blue-600 peer-checked:bg-blue-50 peer-checked:text-blue-900 peer-checked:font-semibold
                                transition-colors">
                      <%= team.name %>
                    </div>
                  </label>
                <% end %>
              <% end %>
            </div>

            <%= f.submit @current_pick ? "Update Pick" : "Confirm Pick",
                class: "w-full sm:w-auto bg-blue-900 text-white px-6 py-2 rounded font-semibold
                        hover:bg-blue-800 cursor-pointer" %>
          <% end %>
        <% end %>
      </div>
    <% end %>
  </div>

  <%# ── Pick history ────────────────────────────────────────────── %>
  <% if @past_picks.any? %>
    <div class="bg-white rounded-lg shadow mb-4">
      <div class="px-4 py-3 border-b border-gray-100">
        <h3 class="font-semibold text-gray-700">Pick History</h3>
      </div>
      <div class="overflow-x-auto">
        <table class="w-full text-sm">
          <thead>
            <tr class="text-left text-gray-400 text-xs border-b border-gray-100">
              <th class="px-4 py-2 font-medium">Week</th>
              <th class="px-4 py-2 font-medium">Team</th>
              <th class="px-4 py-2 font-medium">Result</th>
            </tr>
          </thead>
          <tbody>
            <% @past_picks.each do |pick| %>
              <tr class="border-b border-gray-50 last:border-0">
                <td class="px-4 py-3 text-gray-500"><%= pick.week.week_number %></td>
                <td class="px-4 py-3 text-gray-800 font-medium"><%= pick.team.name %></td>
                <td class="px-4 py-3">
                  <% if pick.is_correct.nil? %>
                    <span class="text-gray-400 text-xs">Pending</span>
                  <% elsif pick.is_correct %>
                    <span class="text-green-600 font-semibold text-xs">✓ Correct</span>
                  <% else %>
                    <span class="text-red-600 font-semibold text-xs">✗ Incorrect</span>
                  <% end %>
                </td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    </div>
  <% end %>

  <%# ── Footer links ─────────────────────────────────────────────── %>
  <div class="flex flex-wrap gap-4 text-sm mt-2">
    <%= link_to "Pool Standings →", status_pool_path(@pool), class: "text-blue-900 hover:underline" %>
    <%= link_to "← My Pools", root_path, class: "text-gray-500 hover:underline" %>
  </div>
</div>
