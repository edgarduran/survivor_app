<div class="max-w-md mx-auto">
  <h2 class="text-3xl font-bold text-gray-800 mb-6">Create a Pool</h2>

  <%= form_with model: @pool, class: "bg-white rounded-lg shadow p-6" do |f| %>
    <% if @pool.errors.any? %>
      <div class="bg-red-50 border border-red-200 rounded p-4 mb-6">
        <ul class="text-red-700 text-sm list-disc pl-4">
          <% @pool.errors.full_messages.each do |msg| %>
            <li><%= msg %></li>
          <% end %>
        </ul>
      </div>
    <% end %>

    <div class="mb-4">
      <%= f.label :name, "Pool Name", class: "block text-sm font-semibold text-gray-700 mb-1" %>
      <%= f.text_field :name, placeholder: "e.g. Friends League 2025",
          class: "w-full border border-gray-300 rounded px-3 py-2 focus:outline-none focus:ring-2 focus:ring-blue-500" %>
    </div>

    <div class="mb-6">
      <%= f.label :season_id, "Season", class: "block text-sm font-semibold text-gray-700 mb-1" %>
      <% if @seasons.empty? %>
        <p class="text-sm text-red-600">No seasons available yet.</p>
      <% else %>
        <%= f.select :season_id, @seasons.map { |s| [s.label, s.id] }, { include_blank: "Select a season" },
            class: "w-full border border-gray-300 rounded px-3 py-2 focus:outline-none focus:ring-2 focus:ring-blue-500" %>
      <% end %>
    </div>

    <%# Commissioner assignment %>
    <div class="mb-6 border border-gray-200 rounded-lg p-4">
      <p class="text-sm font-semibold text-gray-700 mb-3">Commissioner</p>

      <label class="flex items-center gap-2 mb-3 cursor-pointer">
        <input type="radio" name="commissioner_type" value="self" checked class="peer accent-blue-900">
        <span class="text-sm text-gray-700">I will be the commissioner</span>
      </label>

      <label class="flex items-center gap-2 cursor-pointer">
        <input type="radio" name="commissioner_type" value="other" id="commissioner_type_other" class="peer accent-blue-900">
        <span class="text-sm text-gray-700">Delegate to another user (send invite)</span>
      </label>

      <div id="commissioner_email_field" class="mt-3 hidden">
        <input type="email" name="commissioner_email" placeholder="Commissioner's email address"
               class="w-full border border-gray-300 rounded px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-blue-500">
      </div>
    </div>

    <div class="flex justify-end gap-3">
      <%= link_to "Cancel", root_path, class: "px-4 py-2 text-gray-500 hover:underline" %>
      <%= f.submit "Create Pool",
          class: "bg-blue-900 text-white px-4 py-2 rounded font-semibold hover:bg-blue-800 cursor-pointer" %>
    </div>
  <% end %>
</div>

<script>
  document.getElementById("commissioner_type_other").addEventListener("change", function() {
    document.getElementById("commissioner_email_field").classList.toggle("hidden", !this.checked);
  });
  document.querySelectorAll("input[name='commissioner_type']").forEach(function(radio) {
    radio.addEventListener("change", function() {
      document.getElementById("commissioner_email_field").classList.toggle("hidden", this.value !== "other");
    });
  });
</script>
