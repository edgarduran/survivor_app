<div class="max-w-2xl mx-auto">
  <div class="flex justify-between items-start mb-6">
    <div>
      <h2 class="text-2xl font-bold text-gray-800"><%= @pool.name %></h2>
      <p class="text-gray-500 text-sm"><%= @pool.season.label %> · Pool Standings</p>
    </div>
    <%= link_to "← Back to Pool", @pool, class: "text-sm text-blue-900 hover:underline mt-1" %>
  </div>

  <div class="bg-white rounded-lg shadow">
    <div class="px-4 py-3 border-b border-gray-100 flex justify-between text-xs font-semibold text-gray-400 uppercase tracking-wide">
      <span>Player</span>
      <div class="flex gap-6">
        <span>Picks</span>
        <span>Strikes</span>
        <span>Status</span>
      </div>
    </div>

    <ul>
      <% @members.each_with_index do |member, i| %>
        <li class="flex justify-between items-center px-4 py-3 border-b border-gray-50 last:border-0
                   <%= member[:eliminated] ? 'opacity-50' : '' %>">
          <div class="flex items-center gap-2">
            <span class="text-gray-400 text-sm w-5"><%= i + 1 %></span>
            <div>
              <p class="text-gray-800 font-medium text-sm">
                <%= member[:user].first_name %> <%= member[:user].last_name %>
              </p>
              <% if member[:role] == "admin" %>
                <p class="text-xs text-blue-600">Commissioner</p>
              <% end %>
            </div>
          </div>

          <div class="flex items-center gap-6 text-sm">
            <span class="text-gray-500 text-center w-8"><%= member[:picks_count] %></span>

            <div class="flex gap-0.5 w-12 justify-center">
              <% Pick::INCORRECT_PICK_LIMIT.times do |i| %>
                <span><%= i < member[:incorrect_count] ? "⚡" : "○" %></span>
              <% end %>
            </div>

            <% if member[:eliminated] %>
              <span class="text-red-500 font-semibold text-xs w-20 text-right">Eliminated</span>
            <% else %>
              <span class="text-green-600 font-semibold text-xs w-20 text-right">Alive</span>
            <% end %>
          </div>
        </li>
      <% end %>
    </ul>
  </div>
</div>
